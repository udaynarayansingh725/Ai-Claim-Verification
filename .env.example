# Google Gemini API Key (Optional if OpenAI is provided)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional if Gemini is provided, e.g. gpt-4o, gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Tavily API Key (Required for web search agent)
TAVILY_API_KEY=your_tavily_api_key_here

# PostgreSQL Database Connection String (asyncpg format)
DATABASE_URL=postgresql+asyncpg://admin:password@localhost:5432/factify

# Application Settings
LOG_LEVEL=DEBUG
APP_ENV=development
